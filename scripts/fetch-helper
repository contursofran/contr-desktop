#!/bin/sh
# Downloads the newest contr-core release and puts herdr-contr-feed and
# herdr-contr-orch in bin/ (git ignores it), and the Linux x86_64 helper in
# bin/linux-x64/. The packaged app bundles them (docs/reference/releases.md).
# The app takes CONTR_HELPER over bin/.
# Uses gh to read contr-core's releases (a public repository).
set -eu
repo="${HERDR_CONTR_REPO:-contursofran/contr-core}"
root="$(cd "$(dirname "$0")/.." && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
tag="$(gh release list -R "$repo" --exclude-pre-releases --limit 20 --json tagName -q '[.[].tagName | select(startswith("build-"))][0]')"
[ -n "$tag" ] || { echo "no build-* release in $repo" >&2; exit 1; }
gh release download "$tag" -R "$repo" --pattern '*.zip' --dir "$work"
unzip -q -o "$work"/*.zip -d "$work/zip"
mkdir -p "$root/bin"
for name in herdr-contr-feed herdr-contr-orch; do
  file="$(find "$work/zip" -type f -path "*bin/$name" | head -n 1)"
  [ -n "$file" ] || { echo "$name is not in $tag" >&2; exit 1; }
  install -m 755 "$file" "$root/bin/$name"
done
# The Linux x86_64 helper, for the AppImage (electron-builder.yml).
linux="$(find "$work/zip" -type f -path "*remote/x86_64-unknown-linux-musl/herdr-contr-feed" | head -n 1)"
if [ -n "$linux" ]; then
  mkdir -p "$root/bin/linux-x64"
  install -m 755 "$linux" "$root/bin/linux-x64/herdr-contr-feed"
fi
echo "$tag" > "$root/bin/RELEASE"
echo "bin/ has the helper from $tag"
